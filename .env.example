# ==============================================================================
# SalonFlow Environment Configuration (.env.example)
# Copy to .env for local development. Never commit .env with real secrets.
# ==============================================================================

NODE_ENV="development"
LOG_LEVEL="info"

# Primary pooled runtime DB URL (connects as non-superuser app_runtime so PostgreSQL RLS is enforced)
DATABASE_URL="postgresql://app_runtime:salonflow_app_dev@localhost:5434/salonflow?schema=public&connection_limit=20"

# Unpooled direct DB URL (schema owner for Prisma migrations and PG LISTEN/NOTIFY)
DIRECT_URL="postgresql://salonflow_admin:salonflow_admin_dev@localhost:5434/salonflow?schema=public"

# Isolated test DB URL (non-superuser role for integration, RLS & concurrency tests)
TEST_DATABASE_URL="postgresql://app_runtime:salonflow_app_dev@localhost:5434/salonflow_test?schema=public"

# Canonical public application origin
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Secrets (Generate with: openssl rand -base64 32 / openssl rand -hex 32)
AUTH_SECRET="dev-only-change-me-to-32-plus-char-random-secret-key"
IP_HASH_SALT="dev-only-change-me-ip-hash-salt-hex-value-32-chars"
CRON_SECRET="dev-only-change-me-cron-secret-24-chars"

# Web Push VAPID Keys (Generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:alerts@salonflow.local"

# Realtime & Workers
REALTIME_TRANSPORT="memory"
OUTBOX_WORKER_ENABLED="true"
OUTBOX_POLL_INTERVAL_MS="5000"

# SaaS Controls
REQUIRE_ADMIN_TENANT_APPROVAL="false"
PII_RETENTION_DAYS="180"


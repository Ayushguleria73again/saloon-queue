# ==============================================================================
# SalonFlow Production Environment Configuration Template (.env.production.example)
# Copy to .env.production on the production host: chmod 600 .env.production
# ==============================================================================

NODE_ENV="production"
LOG_LEVEL="info"

# Database Connections
# DATABASE_URL: Must connect as the non-superuser 'app_runtime' role to enforce PostgreSQL RLS!
DATABASE_URL="postgresql://app_runtime:SECURE_RUNTIME_PASSWORD_HERE@db:5432/salonflow?schema=public&connection_limit=30"

# DIRECT_URL: Admin credentials used ONLY for running Prisma schema migrations and PG LISTEN
DIRECT_URL="postgresql://salonflow_admin:SECURE_ADMIN_PASSWORD_HERE@db:5432/salonflow?schema=public"

# Canonical Production Application URLs (Must be HTTPS)
NEXT_PUBLIC_APP_URL="https://salonflow.com"
AUTH_URL="https://salonflow.com"

# High-Entropy Production Secrets (Generate via: openssl rand -base64 48 / openssl rand -hex 16)
AUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_48_KEY"
IP_HASH_SALT="REPLACE_WITH_OPENSSL_RAND_HEX_16_KEY"
CRON_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_16_KEY"

# Web Push VAPID Keypair (Generate via: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="REPLACE_WITH_GENERATED_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="REPLACE_WITH_GENERATED_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:security@salonflow.com"

# Outbox & Notification Background Worker
OUTBOX_WORKER_ENABLED="true"
OUTBOX_POLL_INTERVAL_MS="3000"

# Real-Time Transport (Use 'memory' for single container, 'pg-listen' for horizontal clustering)
REALTIME_TRANSPORT="memory"

# SaaS Compliance & Governance
REQUIRE_ADMIN_TENANT_APPROVAL="false"
PII_RETENTION_DAYS="180"

# Off-Site Backup Storage Configuration (scripts/sync-backup-offsite.sh)
BACKUP_S3_BUCKET="s3://salonflow-backups-production"
BACKUP_S3_REGION="ap-south-1"

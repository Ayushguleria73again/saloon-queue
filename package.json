{
  "name": "salonflow",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "node prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "seed:admin": "vite-node scripts/seed-platform-admin.ts",
    "env:validate": "vite-node scripts/validate-production-env.ts",
    "ssl:setup": "scripts/setup-ssl.sh",
    "db:backup": "scripts/backup.sh",
    "db:backup:offsite": "scripts/sync-backup-offsite.sh",
    "db:restore": "scripts/restore.sh",
    "deploy": "scripts/deploy.sh",
    "test": "vitest run --no-file-parallelism",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run tests/integration --no-file-parallelism",
    "test:watch": "vitest",
    "load:seed": "vite-node tests/load/scripts/seed-load-data.ts",
    "load:cleanup": "vite-node tests/load/scripts/cleanup-load-data.ts",
    "load:smoke": "artillery run tests/load/profiles/01-smoke.yml",
    "load:baseline": "artillery run tests/load/profiles/02-baseline.yml",
    "load:load": "artillery run tests/load/profiles/03-load.yml",
    "load:stress": "artillery run tests/load/profiles/04-stress.yml",
    "load:capacity": "artillery run tests/load/profiles/05-capacity.yml",
    "load:spike": "artillery run tests/load/profiles/06-spike.yml",
    "load:soak": "artillery run tests/load/profiles/07-soak.yml",
    "load:browser": "node tests/load/scenarios/browser-flow.js 3",
    "load:sse": "node tests/load/scenarios/sse-flow.js 50 10000",
    "load:suite": "tests/load/scripts/run-all-profiles.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.477.0",
    "next": "^15.2.4",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^4.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "artillery": "^2.0.34",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
